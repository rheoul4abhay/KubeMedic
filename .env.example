# KubeMedic environment variables
# Copy this to .env and fill in your values
# Never commit .env to Git

APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite for early development)
DATABASE_URL=sqlite+aiosqlite:///./kubemedic.db

# Decision provider mode: mock | replay | rules_only | live
DECISION_PROVIDER_MODE=mock

# Webhook authentication token
WEBHOOK_AUTH_TOKEN=change-me-before-use

